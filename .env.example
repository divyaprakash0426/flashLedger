# flashLedger Environment Variables

# Provider Option 1: Vercel AI Gateway (Free Jev until Sep 15)
# Uses endpoint https://ai-gateway.vercel.sh/typesafe/v1/systemone
VERCEL_AI_GATEWAY_API_KEY=your_vercel_ai_gateway_api_key_here
AI_GATEWAY_API_KEY=your_vercel_ai_gateway_api_key_here

# Provider Option 2: OpenRouter
# Uses model 'typesafe/jev-1.13' via the /api/alpha/decisions endpoint
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Provider Option 3: Direct TypeSafe API
# Uses official TypeSafe SDK client via https://api.typesafe.ai
TYPESAFE_API_KEY=your_typesafe_api_key_here

# Optional: Custom API Base URL
# TYPESAFE_BASE_URL=https://ai-gateway.vercel.sh/typesafe
