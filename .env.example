# flashLedger Environment Variables

# Provider Option 1: OpenRouter (recommended if you already have OpenRouter credits)
# Uses model 'typesafe/jev-1.13' via the /api/alpha/decisions endpoint
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Provider Option 2: Direct TypeSafe API
# Uses official TypeSafe SDK client via https://api.typesafe.ai
TYPESAFE_API_KEY=your_typesafe_api_key_here

# Optional: Custom API Base URL
# TYPESAFE_BASE_URL=https://openrouter.ai/api/alpha/decisions
